{
  "name": "Lean",
  "author": "Lean contributors",
  "themes": [
    {
      "name": "Lean Dark",
      "mode": "dark",
      "font.size": 14,
      "mono_font.family": "JetBrainsMono Nerd Font",
      "mono_font.size": 14,
      "radius": 6,
      "radius.lg": 10,
      "shadow": false,
      "colors": {
        "background": "#0e0e0f",
        "foreground": "#e8e8e6",
        "border": "#ffffff14",
        "window.border": "#ffffff14",
        "ring": "#d6aa72",
        "caret": "#d6aa72",
        "overlay": "#00000099",

        "accent.background": "#d6aa721f",
        "accent.foreground": "#e8e8e6",
        "muted.background": "#19191c",
        "muted.foreground": "#7a7a80",

        "primary.background": "#d6aa72",
        "primary.foreground": "#0e0e0f",
        "primary.hover.background": "#dfb886",
        "primary.active.background": "#c4823e",

        "secondary.background": "#19191c",
        "secondary.foreground": "#e8e8e6",
        "secondary.hover.background": "#1f1f23",
        "secondary.active.background": "#242428",

        "selection.background": "#d6aa7238",
        "input.border": "#ffffff1a",
        "drag.border": "#d6aa72",
        "drop_target.background": "#d6aa7224",

        "list.background": "#141416",
        "list.hover.background": "#ffffff0d",
        "list.active.background": "#d6aa7224",
        "list.active.border": "#d6aa7266",
        "list.even.background": "#141416",
        "list.head.background": "#141416",

        "popover.background": "#1c1c20",
        "popover.foreground": "#e8e8e6",

        "sidebar.background": "#141416",
        "sidebar.foreground": "#e8e8e6",
        "sidebar.border": "#ffffff14",
        "sidebar.accent.background": "#d6aa721f",
        "sidebar.accent.foreground": "#e8e8e6",
        "sidebar.primary.background": "#d6aa72",
        "sidebar.primary.foreground": "#0e0e0f",

        "tab.background": "#141416",
        "tab.foreground": "#7a7a80",
        "tab.active.background": "#0e0e0f",
        "tab.active.foreground": "#e8e8e6",
        "tab_bar.background": "#141416",

        "title_bar.background": "#0e0e0f",
        "title_bar.border": "#0e0e0f",
        "status_bar.background": "#0e0e0f",
        "status_bar.border": "#0e0e0f",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#ffffff1a",
        "scrollbar.thumb.hover.background": "#ffffff2e",

        "link": "#d6aa72",
        "link.hover": "#e2c196",
        "link.active": "#c4823e",

        "danger.background": "#e08a7a",
        "danger.foreground": "#0e0e0f",
        "warning.background": "#c4823e",
        "warning.foreground": "#0e0e0f",
        "success.background": "#8fc79a",
        "success.foreground": "#0e0e0f",
        "info.background": "#818cf8",
        "info.foreground": "#0e0e0f",

        "base.red": "#e08a7a",
        "base.red.light": "#eaa598",
        "base.green": "#8fc79a",
        "base.green.light": "#aad6b3",
        "base.yellow": "#d9c48e",
        "base.yellow.light": "#e6d5ab",
        "base.blue": "#818cf8",
        "base.blue.light": "#a4acfa",
        "base.magenta": "#b89cc4",
        "base.magenta.light": "#cdb7d6",
        "base.cyan": "#7fb8b0",
        "base.cyan.light": "#a0ccc6"
      },
      "highlight": {
        "editor.foreground": "#d6d6d4",
        "editor.background": "#0e0e0f",
        "editor.active_line.background": "#ffffff08",
        "editor.line_number": "#4a4a50",
        "editor.active_line_number": "#b4b4b8",
        "editor.invisible": "#4a4a5080",
        "error": "#e08a7a",
        "warning": "#c4823e",
        "info": "#818cf8",
        "success": "#8fc79a",
        "hint": "#7a7a80",
        "syntax": {
          "attribute": { "color": "#c4823e" },
          "boolean": { "color": "#e08a7a" },
          "comment": { "color": "#7a7a80", "font_style": "italic" },
          "comment.doc": { "color": "#8a8a90", "font_style": "italic" },
          "constant": { "color": "#e08a7a" },
          "constructor": { "color": "#a3a8e8" },
          "embedded": { "color": "#d6d6d4" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#a3a8e8" },
          "function": { "color": "#dccb9f" },
          "hint": { "color": "#7a7a80", "font_style": "italic" },
          "keyword": { "color": "#d6aa72" },
          "label": { "color": "#b89cc4" },
          "link_text": { "color": "#a3a8e8", "font_style": "underline" },
          "link_uri": { "color": "#7fb8b0", "font_style": "italic" },
          "number": { "color": "#e08a7a" },
          "operator": { "color": "#a8a8ae" },
          "predictive": { "color": "#4a4a50", "font_style": "italic" },
          "preproc": { "color": "#c4823e" },
          "property": { "color": "#b4b4b8" },
          "punctuation": { "color": "#86868c" },
          "punctuation.bracket": { "color": "#9a9aa0" },
          "punctuation.delimiter": { "color": "#86868c" },
          "punctuation.list_marker": { "color": "#d6aa72" },
          "punctuation.special": { "color": "#c4823e" },
          "string": { "color": "#8fc79a" },
          "string.escape": { "color": "#7fb8b0" },
          "string.regex": { "color": "#7fb8b0" },
          "string.special": { "color": "#7fb8b0" },
          "string.special.symbol": { "color": "#7fb8b0" },
          "tag": { "color": "#d6aa72" },
          "tag.doctype": { "color": "#7a7a80" },
          "text.code.span": { "color": "#8fc79a" },
          "text.literal": { "color": "#8fc79a" },
          "title": { "color": "#d6aa72", "font_weight": 600 },
          "type": { "color": "#a3a8e8" },
          "variable": { "color": "#d6d6d4" },
          "variable.special": { "color": "#c4823e" },
          "variant": { "color": "#a3a8e8" }
        }
      }
    }
  ]
}
